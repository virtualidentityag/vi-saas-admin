VITE_PORT=9000
BROWSER=none

VITE_CSRF_WHITELIST_HEADER_FOR_LOCAL_DEVELOPMENT=TOKEN
VITE_API_URL=develop.myDomain.net

# OPTIONAL

# forces the usage of the api url for all api calls # e.g. useful for local development
# VITE_USE_API_URL=true

# Reverse-proxy target for /service/* requests in dev mode.
# Default: https://happylife.develop.onlineberatung.net
# VITE_DEV_PROXY_TARGET=https://happylife.develop.onlineberatung.net

# Tenant slug for local development (no subdomain on localhost).
# Default: happylife
# VITE_TENANT_SLUG=happylife

# Keep cookies on logout (comma seperated list)
VITE_COOKIES_ALLOWEDLIST=devProxy